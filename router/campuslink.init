#!/bin/sh /etc/rc.common
# CampusLink Router 控制面 —— OpenWrt procd 服务脚本
#
# 安装：把本文件放到 /etc/init.d/campuslink，chmod +x，然后
#   /etc/init.d/campuslink enable
#   /etc/init.d/campuslink start
#
# 约定（见 README.md）：
#   · 代码树在 /opt/campuslink，含 vendored 依赖（_vendor/packages）
#   · CAMPUSLINK_VENDOR=1 让 _vendor.install() 注入 vendored 纯 Python 依赖
#   · 日志 / 队列 / 图像全在 tmpfs（/tmp），不写 flash（决策 D5/D8）

START=99
STOP=10

USE_PROCD=1
PROG=/opt/campuslink

start_service() {
    procd_open_instance
    # 直接跑启动脚本（它内部自己 export PYTHONPATH / CAMPUSLINK_VENDOR 再 exec python），
    # 不依赖 procd 传 env —— 部分改版 OpenWrt 的 procd_set_param env 不生效。
    procd_set_param command /opt/campuslink/campuslink-run.sh
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits nofile=1024
    procd_close_instance
}

stop_service() {
    :
}

service_triggers() {
    procd_add_reload_trigger "campuslink"
}
