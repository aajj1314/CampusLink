# ------------------------------------------------------------------ 构建产物
build/
dist/
packaging/output/
*.ipk
*.spec.bak

# ------------------------------------------------------------------ Python 环境与缓存
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------ 本地打包备份（体积很大，不入库）
CampusLink.rar
*.rar
*.7z

# ------------------------------------------------------------------ Agent/IDE 本地工作目录（含本机路径等本地信息）
.workbuddy/
.idea/
.vscode/

# ------------------------------------------------------------------ 运行时产物
*.log
logs/

# ------------------------------------------------------------------ ML 训练数据与模型
# 验证码样本属敏感物料，训练产物体积大，均不入库
ml/dataset/raw/
ml/dataset/test_raw/
ml/dataset/labels/
ml/dataset/preprocess_samples/
ml/dataset/tmp/
ml/dataset/*.csv
# 模型权重通过 GitHub Release 分发（见 ml/models/README.md），不入 git；
# 仅保留本说明文件
ml/models/*
!ml/models/README.md
ml/dataset.zip

# ml2/：处理版图（对比度增强）独立模型线，数据集与产物同样不入库
ml2/dataset/
ml2/models/

# ------------------------------------------------------------------ 历史数据目录（Linux 侧传回的副本，敏感物料不入库）
dataset/
dist2/
build2/
dist3/
build3/
dist4/
build4/
dist5/
build5/
dist6/
build6/
dist7/
build7/

# 2026-11-18：统一用通配，省得每次新构建目录都要加一条
# （HANDOVER 里记的"产物目录删不掉导致静默用旧包"就是这么来的）
dist*/
build*/
# 打包自检的输出文件（exe --selftest 会在安装目录生成）
selftest.txt